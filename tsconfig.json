{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@client/*": ["./client/src/*"],
      "@server/*": ["./server/src/*"]
    }
  },
  "include": ["jest.config.ts", "tests/**/*"],
  "exclude": ["node_modules"]
}
