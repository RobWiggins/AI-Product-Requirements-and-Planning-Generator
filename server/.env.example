# Copy to server/.env and fill in. Never commit server/.env.

NODE_ENV=development
PORT=3001

# PostgreSQL (also used by Prisma via src/db/connection.ts)
PGHOST=localhost
PGPORT=5432
PGDATABASE=storyflow
PGUSER=storyflow
PGPASSWORD=

# Anthropic
ANTHROPIC_API_KEY=

# --- Auth --------------------------------------------------------------------
# Where the Vite client runs; OAuth callbacks redirect here.
CLIENT_URL=http://localhost:3000
# Public origin of this API; OAuth redirect URIs are built from it.
# Local Vite: use the client origin so Google returns through the /api proxy
# and the session cookie is set on localhost:3000.
API_PUBLIC_URL=http://localhost:3000
# Optional overrides
# SESSION_COOKIE_NAME=sf_session
# SESSION_TTL_DAYS=30

# Google — https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: ${API_PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — https://github.com/settings/developers  (OAuth Apps)
#   Authorization callback URL: ${API_PUBLIC_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# "Continue as Guest" needs no configuration. Providers left blank are shown as
# unavailable in the login UI.
